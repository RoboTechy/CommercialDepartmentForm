<%- include('partials/head') %>
<%- include('partials/nav', { user }) %>
  <main class="container container-wide">
    <div class="page-header no-print">
      <h1>فهرست ردیف‌های درخواست</h1>
      <div class="actions">
        <% if (canCreateRows) { %>
          <a href="/rows/new" class="btn btn-primary">+ افزودن ردیف جدید</a>
        <% } %>
        <a href="/logs" class="btn">تاریخچه‌ی کامل تغییرات</a>
        <a href="/reports/duration" class="btn">ابزار گزارش‌ساز</a>
        <% if (isLocalAdmin) { %>
          <a href="/rows/deleted" class="btn">ردیف‌های حذف‌شده</a>
        <% } %>
        <button type="button" class="btn" onclick="window.location.href = '/export.csv' + window.location.search">خروجی CSV</button>
        <button type="button" class="btn" onclick="window.print()">چاپ نتایج</button>
      </div>
    </div>

    <% if (myDraftRows && myDraftRows.length) { %>
      <div class="alert alert-info no-print">
        شما <%= myDraftRows.length %> ردیف پیش‌نویس (ثبت‌نشده) دارید که هنوز در این فهرست نمایش داده نمی‌شوند.
        <a href="/rows/<%= myDraftRows[0].id %>">مشاهده و ثبت نهایی</a>
      </div>
    <% } %>

    <div class="stats-row no-print">
      <a href="/" class="stat-card" title="نمایش همه‌ی ردیف‌ها (پاک کردن فیلترها)">
        <span class="stat-value"><%= stats.totalRows %></span>
        <span class="stat-label">کل ردیف‌ها</span>
      </a>
      <% stats.requesterDeptStats.forEach(function(dept) { %>
        <a href="/?incompleteRequesterDept=<%= encodeURIComponent(dept.label) %>" class="stat-card section-tech_operator" title="نمایش ردیف‌های جاری و تکمیل‌نشده‌ی «<%= dept.label %>»">
          <span class="stat-value"><%= dept.completed %> <span class="stat-value-sep">/</span> <%= dept.pending %></span>
          <span class="stat-label"><%= dept.label %> (تکمیل‌شده / در انتظار)</span>
        </a>
      <% }) %>
      <% stats.departments.forEach(function(dept) { %>
        <a href="/?incompleteDept=<%= dept.color %>" class="stat-card section-<%= dept.color %>" title="نمایش ردیف‌های جاری و تکمیل‌نشده‌ی «<%= dept.title %>»">
          <span class="stat-value"><%= dept.completed %> <span class="stat-value-sep">/</span> <%= dept.pending %></span>
          <span class="stat-label"><%= dept.title %> (تکمیل‌شده / در انتظار)</span>
        </a>
      <% }) %>
      <div class="stat-card">
        <span class="stat-value"><%= stats.avgCompletionDays !== null ? stats.avgCompletionDays.toFixed(1) : '—' %></span>
        <span class="stat-label">میانگین روز تا تکمیل کامل (<%= stats.fullyCompleted %> ردیف تکمیل‌شده)</span>
      </div>
      <a href="/?status=cancelled" class="stat-card stat-card-cancelled" title="نمایش ردیف‌های لغو شده">
        <span class="stat-value"><%= stats.cancelledCount %></span>
        <span class="stat-label">لغو شده</span>
      </a>
      <a href="/?status=returned" class="stat-card stat-card-returned" title="نمایش ردیف‌های عودت به درخواست‌کننده">
        <span class="stat-value"><%= stats.returnedCount %></span>
        <span class="stat-label">عودت به درخواست‌کننده</span>
      </a>
    </div>

    <form method="get" action="/" class="filter-form">
      <div class="filter-actions no-print">
        <button type="submit" class="btn btn-primary btn-sm">اعمال فیلتر</button>
        <a href="/" class="btn btn-sm">پاک کردن فیلترها</a>
      </div>
      <div class="table-scroll">
        <table class="table sheet-table">
          <thead>
            <tr>
              <th rowspan="3" class="col-id">ردیف</th>
              <th rowspan="2" class="col-status">وضعیت</th>
              <% sections.forEach(function(section) { %>
                <th colspan="<%= section.fields.length %>" class="section-head section-<%= section.color %> section-boundary"><%= section.title %></th>
              <% }) %>
              <th rowspan="3" class="col-actions no-print">عملیات</th>
            </tr>
            <tr>
              <% sections.forEach(function(section) { %>
                <% section.fields.forEach(function(field, idx) { %>
                  <th class="section-<%= section.color %><%= idx === section.fields.length - 1 ? ' section-boundary' : '' %>"><%= field.label %></th>
                <% }) %>
              <% }) %>
            </tr>
            <tr class="filter-row no-print">
              <th class="col-status">
                <select name="status">
                  <option value="">همه</option>
                  <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>جاری</option>
                  <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>لغو شده</option>
                  <option value="returned" <%= query.status === 'returned' ? 'selected' : '' %>>عودت به درخواست‌کننده</option>
                </select>
              </th>
              <% sections.forEach(function(section) { %>
                <% section.fields.forEach(function(field, idx) { %>
                  <th class="section-<%= section.color %><%= idx === section.fields.length - 1 ? ' section-boundary' : '' %>">
                    <% if (field.type === 'select') { %>
                      <select name="<%= field.name %>">
                        <option value="">همه</option>
                        <% field.options.forEach(function(opt) { %>
                          <option value="<%= opt %>" <%= query[field.name] === opt ? 'selected' : '' %>><%= opt %></option>
                        <% }) %>
                      </select>
                    <% } else if (field.type === 'jalali-date') { %>
                      <div class="filter-date-range">
                        <input type="text" class="jalali-date-text" name="<%= field.name %>_from" placeholder="از" value="<%= query[field.name + '_from'] || '' %>" />
                        <input type="text" class="jalali-date-text" name="<%= field.name %>_to" placeholder="تا" value="<%= query[field.name + '_to'] || '' %>" />
                      </div>
                    <% } else { %>
                      <input type="text" name="<%= field.name %>" placeholder="جستجو..." value="<%= query[field.name] || '' %>" list="dl-<%= field.name %>" autocomplete="off" />
                    <% } %>
                  </th>
                <% }) %>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="100" class="muted center-cell">هیچ ردیفی با این فیلتر پیدا نشد.</td></tr>
            <% } %>
            <% rows.forEach(function(row) { %>
              <tr class="<%= row.cancelled_at ? 'row-cancelled' : (row.returned_at ? 'row-returned' : (row.isOverdue ? 'row-overdue' : '')) %>">
                <td>
                  <%= row.id %>
                  <% if (row.isOverdue) { %> <span class="overdue-badge" title="بیش از <%= overdueDays %> روز از ایجاد این ردیف گذشته و هنوز تکمیل نشده">⏳</span><% } %>
                </td>
                <td>
                  <% if (row.cancelled_at) { %>
                    <span class="status-badge status-cancelled" title="لغو شد توسط <%= row.cancelled_by_display %> در <%= row.cancelled_at %> - دلیل: <%= row.cancel_reason %>">لغو شده</span>
                  <% } else if (row.returned_at) { %>
                    <span class="status-badge status-returned" title="عودت داده شد توسط <%= row.returned_by_display %> در <%= row.returned_at %><% if (row.return_reason) { %> - دلیل: <%= row.return_reason %><% } %>">عودت به درخواست‌کننده</span>
                  <% } else { %>
                    <span class="status-badge status-active">جاری</span>
                  <% } %>
                </td>
                <% sections.forEach(function(section) { %>
                  <% section.fields.forEach(function(field, idx) { %>
                    <td class="section-<%= section.color %><%= idx === section.fields.length - 1 ? ' section-boundary' : '' %>">
                      <% if (field.name === 'request_no' && row[field.name]) { %>
                        <a href="/rows/<%= row.id %>"><%= row[field.name] %></a>
                      <% } else { %>
                        <%= row[field.name] || '-' %>
                      <% } %>
                    </td>
                  <% }) %>
                <% }) %>
                <td class="no-print actions-cell">
                  <a href="/rows/<%= row.id %>" class="btn btn-sm">مشاهده / ویرایش</a>
                  <a href="/rows/<%= row.id %>/history" class="btn btn-sm">تاریخچه</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="filter-actions no-print">
        <button type="submit" class="btn btn-primary btn-sm">اعمال فیلتر</button>
        <a href="/" class="btn btn-sm">پاک کردن فیلترها</a>
      </div>
    </form>

    <% sections.forEach(function(section) { %>
      <% section.fields.forEach(function(field) { %>
        <% if (distinctValues[field.name]) { %>
          <datalist id="dl-<%= field.name %>">
            <% distinctValues[field.name].forEach(function(val) { %>
              <option value="<%= val %>"></option>
            <% }) %>
          </datalist>
        <% } %>
      <% }) %>
    <% }) %>
  </main>
</body>
</html>
