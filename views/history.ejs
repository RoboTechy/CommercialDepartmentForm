<%- include('partials/head') %>
<%- include('partials/nav', { user }) %>
  <main class="container">
    <div class="page-header no-print">
      <h1>تاریخچه‌ی ردیف شماره <%= row.id %></h1>
      <div class="actions">
        <button type="button" class="btn" onclick="window.print()">چاپ</button>
        <a href="/rows/<%= row.id %>" class="btn">بازگشت به ردیف</a>
        <a href="/" class="btn">فهرست ردیف‌ها</a>
      </div>
    </div>

    <% if (!history.length) { %>
      <p class="muted">هنوز هیچ تغییری روی این ردیف ثبت نشده است.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>تاریخ و ساعت</th>
              <th>بخش</th>
              <th>فیلد</th>
              <th>مقدار قبلی</th>
              <th>مقدار جدید</th>
              <th>تغییر توسط</th>
            </tr>
          </thead>
          <tbody>
            <% history.forEach(function(entry) { %>
              <tr>
                <td><%= entry.changed_at %></td>
                <td><% var sec = sections.find(function(s) { return s.key === entry.section_key; }); %><%= sec ? sec.title : entry.section_key %></td>
                <td><%= entry.field_label %></td>
                <td><%= entry.old_value || '-' %></td>
                <td><%= entry.new_value || '-' %></td>
                <td><%= entry.changed_by_display %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
