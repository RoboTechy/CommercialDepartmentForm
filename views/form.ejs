<%- include('partials/head') %>
<%- include('partials/nav', { user }) %>
  <main class="container">
    <div class="page-header">
      <div>
        <h1><%= form.title %></h1>
        <p class="muted">
          درخواست‌کننده: <%= form.requesterName || '-' %> ·
          ایجاد شده توسط <%= form.createdBy %> در <%= new Date(form.createdAt).toLocaleString('fa-IR') %>
        </p>
      </div>
      <a href="/" class="btn">بازگشت به فهرست</a>
    </div>

    <% if (message && message.length) { %>
      <div class="alert alert-success"><%= message[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>

    <% sectionsView.forEach(function(section) { %>
      <section class="card section-card">
        <div class="section-header">
          <h2><%= section.title %></h2>
          <span class="badge <%= section.data.status === 'تکمیل شده' ? 'badge-done' : 'badge-pending' %>">
            <%= section.data.status %>
          </span>
        </div>

        <% if (section.data.updatedBy) { %>
          <p class="muted small">
            آخرین ثبت توسط <%= section.data.updatedBy %> در <%= new Date(section.data.updatedAt).toLocaleString('fa-IR') %>
          </p>
        <% } %>

        <% if (section.canEdit) { %>
          <form method="post" action="/forms/<%= form.id %>/sections/<%= section.key %>" class="section-form">
            <% section.fields.forEach(function(field) { %>
              <label>
                <%= field.label %><% if (field.required) { %> <span class="req">*</span><% } %>
                <% var val = section.data.values[field.name] || ''; %>
                <% if (field.type === 'textarea') { %>
                  <textarea name="<%= field.name %>" <%= field.required ? 'required' : '' %>><%= val %></textarea>
                <% } else if (field.type === 'select') { %>
                  <select name="<%= field.name %>">
                    <option value="">— انتخاب کنید —</option>
                    <% field.options.forEach(function(opt) { %>
                      <option value="<%= opt %>" <%= val === opt ? 'selected' : '' %>><%= opt %></option>
                    <% }) %>
                  </select>
                <% } else { %>
                  <input type="<%= field.type %>" name="<%= field.name %>" value="<%= val %>" <%= field.required ? 'required' : '' %> />
                <% } %>
              </label>
            <% }) %>
            <button type="submit" class="btn btn-primary">ثبت / بروزرسانی «<%= section.title %>»</button>
          </form>
        <% } else { %>
          <div class="readonly-fields">
            <% var hasValues = Object.keys(section.data.values || {}).length > 0; %>
            <% if (!hasValues) { %>
              <p class="muted">این بخش هنوز توسط پرسنل «<%= section.title %>» تکمیل نشده است.</p>
            <% } else { %>
              <% section.fields.forEach(function(field) { %>
                <div class="ro-field">
                  <span class="ro-label"><%= field.label %>:</span>
                  <span class="ro-value"><%= section.data.values[field.name] || '-' %></span>
                </div>
              <% }) %>
            <% } %>
            <p class="muted small">🔒 شما مجاز به ویرایش این بخش نیستید (فقط پرسنل «<%= section.title %>»<% if (isAdmin) { %> یا مدیر سیستم<% } %>).</p>
          </div>
        <% } %>
      </section>
    <% }) %>
  </main>
</body>
</html>
