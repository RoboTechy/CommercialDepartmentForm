<%- include('partials/head') %>
<%- include('partials/nav', { user }) %>
  <main class="container">
    <div class="page-header no-print">
      <div>
        <h1>
          ردیف شماره <%= row.id %>
          <% if (row.cancelled_at) { %>
            <span class="status-badge status-cancelled">لغو شده</span>
          <% } else if (row.returned_at) { %>
            <span class="status-badge status-returned">عودت به درخواست‌کننده</span>
          <% } else if (!row.published_at) { %>
            <span class="status-badge status-draft">پیش‌نویس (ثبت نهایی نشده)</span>
          <% } else { %>
            <span class="status-badge status-active">جاری</span>
          <% } %>
        </h1>
        <p class="muted">
          ایجاد شده توسط <%= row.created_by_display %> در <%= row.created_at %>
        </p>
      </div>
      <div class="actions">
        <a href="/rows/<%= row.id %>/history" class="btn">تاریخچه‌ی این ردیف</a>
        <button type="button" class="btn" onclick="window.print()">چاپ این ردیف</button>
        <a href="/" class="btn">بازگشت به فهرست</a>
        <% if (canCancelRow && !row.deleted_at && !row.cancelled_at && !row.returned_at) { %>
          <button type="button" class="btn btn-danger" onclick="document.getElementById('cancel-form').hidden = false">لغو درخواست</button>
        <% } %>
        <% if (canReturnToTechOffice && !row.deleted_at && !row.cancelled_at && !row.returned_at) { %>
          <button type="button" class="btn btn-danger" onclick="document.getElementById('return-form').hidden = false">عودت به درخواست‌کننده</button>
        <% } %>
        <% if (isLocalAdmin && !row.deleted_at) { %>
          <form method="post" action="/rows/<%= row.id %>/delete" style="display:inline" onsubmit="return confirm('این ردیف حذف شود؟ (قابل بازیابی از «ردیف‌های حذف‌شده» است)');">
            <button type="submit" class="btn btn-danger">حذف ردیف</button>
          </form>
        <% } %>
      </div>
    </div>

    <% if (canCancelRow && !row.deleted_at && !row.cancelled_at && !row.returned_at) { %>
      <form method="post" action="/rows/<%= row.id %>/cancel" class="card no-print" id="cancel-form" hidden>
        <label>دلیل لغو درخواست <span class="req">*</span>
          <input type="text" name="reason" required placeholder="مثلاً: نیاز برطرف شد، دو بار ثبت شده و..." />
        </label>
        <button type="submit" class="btn btn-danger">تایید لغو درخواست</button>
        <button type="button" class="btn" onclick="document.getElementById('cancel-form').hidden = true">انصراف</button>
      </form>
    <% } %>

    <% if (canReturnToTechOffice && !row.deleted_at && !row.cancelled_at && !row.returned_at) { %>
      <form method="post" action="/rows/<%= row.id %>/return" class="card no-print" id="return-form" hidden>
        <label>دلیل عودت به درخواست‌کننده (اختیاری)
          <input type="text" name="reason" placeholder="مثلاً: اطلاعات ناقص است، مغایرت در مشخصات و..." />
        </label>
        <button type="submit" class="btn btn-danger">تایید عودت به درخواست‌کننده</button>
        <button type="button" class="btn" onclick="document.getElementById('return-form').hidden = true">انصراف</button>
      </form>
    <% } %>

    <% if (row.cancelled_at) { %>
      <div class="alert alert-error no-print">
        این درخواست در تاریخ <%= row.cancelled_at %> توسط <%= row.cancelled_by_display %> لغو شده است.
        دلیل: «<%= row.cancel_reason %>»
        <% if (canCancelRow) { %>
          <form method="post" action="/rows/<%= row.id %>/uncancel" style="display:inline">
            <button type="submit" class="btn btn-sm">بازگرداندن از لغو</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <% if (row.returned_at) { %>
      <div class="alert alert-error no-print">
        این درخواست در تاریخ <%= row.returned_at %> توسط <%= row.returned_by_display %> به درخواست‌کننده عودت داده شده است.
        <% if (row.return_reason) { %>دلیل: «<%= row.return_reason %>»<% } %>
        <% if (canReturnToTechOffice) { %>
          <form method="post" action="/rows/<%= row.id %>/unreturn" style="display:inline">
            <button type="submit" class="btn btn-sm">بازگرداندن از عودت</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <% if (row.deleted_at) { %>
      <div class="alert alert-error no-print">
        این ردیف در تاریخ <%= row.deleted_at %> توسط <%= row.deleted_by_display %> حذف شده است.
        <form method="post" action="/rows/<%= row.id %>/restore" style="display:inline">
          <button type="submit" class="btn btn-sm">بازیابی ردیف</button>
        </form>
      </div>
    <% } %>

    <% if (!row.published_at) { %>
      <div class="alert alert-info no-print">
        <p>
          این ردیف هنوز «پیش‌نویس» است و تا زمانی که «ثبت نهایی» را نزنید، در فهرست اصلی نمایش داده
          نمی‌شود. می‌توانید چند ردیف دیگر هم اضافه کنید و همه را با هم یا هرکدام را جدا ثبت نهایی
          کنید؛ هرکدام را که نمی‌خواهید هم می‌توانید کامل حذف کنید (مثلاً اگر در میانه‌ی کار یکی از
          آن‌ها اشتباه شد - بقیه دست‌نخورده می‌مانند).
        </p>

        <form method="post" action="/rows/<%= row.id %>/finalize" id="finalize-drafts-form"></form>
        <div class="draft-list">
          <% draftRows.forEach(function(d) { %>
            <div class="draft-list-item">
              <label>
                <input type="checkbox" name="rowIds" value="<%= d.id %>" checked form="finalize-drafts-form" />
                <a href="/rows/<%= d.id %>">#<%= d.id %><% if (d.id === row.id) { %> (همین ردیف)<% } %></a>
                <%= d.request_no || '—' %>
              </label>
              <form method="post" action="/rows/<%= d.id %>/discard" style="display:inline" onsubmit="return confirm('این پیش‌نویس برای همیشه حذف شود؟ این کار قابل بازگشت نیست (بقیه‌ی پیش‌نویس‌هایتان دست‌نخورده می‌مانند).');">
                <button type="submit" class="btn btn-sm btn-danger">حذف این پیش‌نویس</button>
              </form>
            </div>
          <% }) %>
        </div>

        <div class="actions">
          <a href="/rows/new" class="btn">+ افزودن ردیف جدید</a>
          <button type="submit" form="finalize-drafts-form" class="btn btn-primary">ثبت نهایی موارد تیک‌خورده</button>
        </div>
      </div>
    <% } %>

    <div class="print-only print-header">
      <h1>ردیف شماره <%= row.id %></h1>
      <p>ایجاد شده توسط <%= row.created_by_display %> در <%= row.created_at %></p>
    </div>

    <% if (message && message.length) { %>
      <div class="alert alert-success no-print"><%= message[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-error no-print"><%= error[0] %></div>
    <% } %>

    <%
      // عنوان نمایشی متمایز برای دو بخشی که هر دو «انبار کارفرما» نام دارند
      // (warehouse_1 و warehouse_2 - طبق sections.js عمداً به دو بلوک تقسیم
      // شده‌اند تا بازرگانی غدیر بینشان بیاید) - فقط برای نمایش در نوار
      // مراحل/آکاردئون، در خود sections.js چیزی تغییر نکرده
      function displayTitle(section) {
        if (section.key === 'warehouse_2') return section.title + ' — ارسال نامه';
        return section.title;
      }
      // اولین بخشی که هنوز کامل نیست، به‌صورت پیش‌فرض باز است (مرحله‌ی
      // «فعال»)؛ اگر همه کامل بودند، آخرین بخش باز می‌ماند. توجه: این فقط
      // حالت باز/بسته‌ی پیش‌فرض آکاردئون را تعیین می‌کند - هیچ بخشی قفل یا
      // غیرقابل‌کلیک نیست و هر بخش دقیقاً با همان مجوز قبلی (section.canEdit)
      // قابل مشاهده/ویرایش است؛ کاربر آزاد است هر بخشی را باز/بسته کند.
      var activeIdx = sectionsView.findIndex(function(s) { return !s.isComplete; });
      if (activeIdx === -1) activeIdx = sectionsView.length - 1;
    %>

    <div class="stepper no-print">
      <% sectionsView.forEach(function(section, idx) { %>
        <div class="step <%= section.isComplete ? 'done' : (idx === activeIdx ? 'active' : '') %>">
          <div class="step-line"></div>
          <div class="step-dot"><%= section.isComplete ? '✓' : (idx + 1) %></div>
          <div class="step-label"><%= displayTitle(section) %></div>
        </div>
      <% }) %>
    </div>

    <div class="acc" id="row-accordion">
      <% sectionsView.forEach(function(section, idx) { %>
        <% var state = section.isComplete ? 'state-done' : (idx === activeIdx ? 'state-active' : 'state-future'); %>
        <section class="card section-card acc-item section-<%= section.color %> <%= state %><%= idx === activeIdx ? ' open' : '' %>">
          <button type="button" class="acc-head">
            <span class="acc-head-left">
              <span class="acc-badge"><%= section.isComplete ? '✓' : (idx + 1) %></span>
              <span>
                <h2 class="acc-title"><%= displayTitle(section) %></h2>
                <span class="acc-sub">
                  <% if (!section.canEdit) { %>
                    🔒 فقط پرسنل «<%= section.title %>»<% if (isAdmin) { %> یا مدیر سیستم<% } %> می‌توانند این بخش را ویرایش کنند
                  <% } else if (section.isComplete) { %>
                    تکمیل شده
                  <% } else { %>
                    در انتظار تکمیل
                  <% } %>
                </span>
              </span>
            </span>
            <span class="acc-chevron">▾</span>
          </button>

          <div class="acc-body">
            <% if (section.canEdit) { %>
              <form method="post" action="/rows/<%= row.id %>/sections/<%= section.key %>" class="section-form no-print" data-section-key="<%= section.key %>" data-row-id="<%= row.id %>">
                <% section.fields.forEach(function(field) { %>
                  <%
                    var fieldReadOnlyReason = '';
                    if (field.name === 'payment_auth_issued_date' && paymentAuthWaived) {
                      fieldReadOnlyReason = 'چون مجری خرید «' + row.purchase_executor + '» است، بازرگانی سایت برای این خرید مجوز پرداخت صادر نمی‌کند';
                    }
                  %>
                  <%- include('partials/field-input', { field: field, value: row[field.name] || '', todayJalali: todayJalali, forceReadOnlyReason: fieldReadOnlyReason }) %>
                <% }) %>
                <button type="submit" class="btn btn-primary">ثبت / بروزرسانی «<%= section.title %>»</button>
              </form>
              <div class="readonly-fields print-only">
                <% section.fields.forEach(function(field) { %>
                  <div class="ro-field">
                    <span class="ro-label"><%= field.label %>:</span>
                    <span class="ro-value"><%= row[field.name] || '-' %></span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="readonly-fields">
                <% section.fields.forEach(function(field) { %>
                  <div class="ro-field">
                    <span class="ro-label"><%= field.label %>:</span>
                    <span class="ro-value"><%= row[field.name] || '-' %></span>
                  </div>
                <% }) %>
                <p class="muted small no-print">🔒 شما مجاز به ویرایش این بخش نیستید (فقط پرسنل «<%= section.title %>»<% if (isAdmin) { %> یا مدیر سیستم<% } %>).</p>
              </div>
            <% } %>
          </div>
        </section>
      <% }) %>
    </div>
  </main>
</body>
</html>
