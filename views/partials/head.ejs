<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'PRT' %></title>
  <link rel="icon" type="image/jpeg" href="/LOGO.jpg" />
  <link rel="stylesheet" href="/style.css" />
  <script src="/app.js" defer></script>
</head>
<%
  var _bodyClasses = [];
  if (typeof bodyClass !== 'undefined' && bodyClass) _bodyClasses.push(bodyClass);
  if (typeof nav !== 'undefined' && nav && typeof user !== 'undefined' && user) _bodyClasses.push('has-sidebar');
%>
<body<% if (_bodyClasses.length) { %> class="<%= _bodyClasses.join(' ') %>"<% } %>>
