<%- include('partials/head') %>
  <main class="container center-page">
    <div class="card">
      <h1><%= typeof message !== 'undefined' && message ? 'عدم دسترسی' : '۴۰۴ - یافت نشد' %></h1>
      <% if (typeof message !== 'undefined' && message) { %>
        <p class="alert alert-error"><%= message %></p>
      <% } %>
      <a href="/" class="btn">بازگشت به فهرست</a>
    </div>
  </main>
</body>
</html>
