# این فایل را کپی کنید به .env و مقادیر حساس زیر را پر کنید.
# فایل .env هرگز نباید کامیت/پوش شود (در .gitignore قرار دارد).
#
#   cp .env.example .env

# --- مقادیر حساس (حتماً خودتان پر کنید) ---

# کلید امضای سشن - یک رشته‌ی تصادفی طولانی بگذارید (مثلاً با: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_LONG_SECRET

# رمز عبور حساب سرویس LDAP (همان که در Active Directory ساختید)
LDAP_BIND_PASSWORD=CHANGE_ME

# --- مقادیر غیرحساس (از قبل با اطلاعات Active Directory سازمان پر شده) ---
# اگر روی docker-compose.yml هم همین‌ها ست شده باشند، مقادیر docker-compose.yml
# اولویت دارند؛ این‌ها برای اجرای محلی بدون Docker (npm start) استفاده می‌شوند.

PORT=3000
DB_FILE=./data/app.db

LDAP_URL=ldap://192.168.201.15:389
LDAP_BIND_DN=PRT@bh.igisco.ocmc
LDAP_USER_BASE=DC=bh,DC=igisco,DC=ocmc
LDAP_GROUP_BASE=DC=bh,DC=igisco,DC=ocmc
LDAP_USERNAME_ATTRIBUTE=sAMAccountName

LDAP_GROUP_TECH_OPERATOR=PRT-Technical
LDAP_GROUP_WAREHOUSE=PRT-Warehouse
LDAP_GROUP_COMMERCIAL=PRT-Commercial
LDAP_GROUP_ADMIN=PRT-Admins
