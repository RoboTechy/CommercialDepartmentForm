# پورت وب‌سرویس
PORT=3000

# مسیر فایل دیتابیس SQLite
DB_FILE=/app/data/app.db

# کلید امضای سشن - در محیط واقعی حتما یک مقدار تصادفی طولانی بگذارید
SESSION_SECRET=change-me-to-a-random-secret

# --- تنظیمات LDAP ---
# آدرس سرور LDAP سازمان (در صورت نیاز به LDAPS از ldaps:// استفاده کنید)
LDAP_URL=ldap://openldap:1389

# حساب سرویس برای جستجوی کاربران (Bind DN) - این حساب فقط برای جستجو استفاده می‌شود
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=adminpassword

# محل جستجوی کاربران و گروه‌ها
LDAP_USER_BASE=ou=people,dc=example,dc=com
LDAP_GROUP_BASE=ou=groups,dc=example,dc=com

# نام ویژگی که نام کاربری در آن ذخیره شده (در اکتیودایرکتوری معمولا sAMAccountName)
LDAP_USERNAME_ATTRIBUTE=uid

# نام گروه‌های LDAP که به هر بخش دسترسی تکمیل می‌دهند
# (دفتر فنی بهره‌بردار تنها بخشی است که اجازه‌ی ایجاد ردیف جدید دارد)
LDAP_GROUP_TECH_OPERATOR=tech_operator
LDAP_GROUP_WAREHOUSE=warehouse
LDAP_GROUP_COMMERCIAL=commercial

# گروه مدیر سیستم که به همه‌ی بخش‌ها دسترسی تکمیل دارد (اختیاری)
LDAP_GROUP_ADMIN=formadmin
