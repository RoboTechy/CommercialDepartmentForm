# تنظیمات زمان ساخت (Vite) - فقط متغیرهای با پیشوند VITE_ به برنامه می‌رسند.

# حالت دمو: ورود شبیه‌سازی‌شده، تعویض کاربر و ریست داده‌ها. این پروژه فعلاً فقط فرانت‌اند است
# و داده‌ها در localStorage مرورگر می‌مانند؛ برای استقرار واقعی باید به بک‌اند PRT (LDAP + SQLite) وصل شود
# و این مقدار false شود.
VITE_DEMO_MODE=true

# ماژول آزمایشی (RFQ / تأمین‌کنندگان / تأییدات چندمرحله‌ای / تابلوی مراحل) - در طراحی اصلی PRT نیست
VITE_ENABLE_EXTENDED_WORKFLOW=false
