{
  "name": "commercial-portal-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "docker:build": "docker build -t commercial-portal .",
    "docker:run": "docker run -d -p 8080:80 --name commercial_portal_app commercial-portal",
    "docker:compose": "docker compose up -d --build",
    "docker:compose:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose down",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jalaali-js": "^1.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
